# Environment Variables for Khoj Server - Fly.io Deployment
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ===========================================
# DATABASE CONFIGURATION (Supabase)
# ===========================================
# Get these from your Supabase project settings
POSTGRES_HOST=db.xxx.supabase.co
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-password
POSTGRES_PORT=5432

# ===========================================
# KHOJ CONFIGURATION
# ===========================================
# Generate a secure secret key (use: python -c "import secrets; print(secrets.token_urlsafe(50))")
KHOJ_DJANGO_SECRET_KEY=your-very-secure-secret-key-here

# Admin user configuration
KHOJ_ADMIN_EMAIL=admin@example.com
KHOJ_ADMIN_PASSWORD=your-secure-admin-password

# Application settings
KHOJ_DEBUG=False
KHOJ_NO_HTTPS=False
KHOJ_TELEMETRY_DISABLE=True

# ===========================================
# AI MODEL APIs
# ===========================================
# OpenAI API (for GPT models)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google Gemini API
GEMINI_API_KEY=your-gemini-key-here

# Optional: Local AI models
# OPENAI_BASE_URL=https://your-local-ai-endpoint.com
# KHOJ_DEFAULT_CHAT_MODEL=gpt-4

# ===========================================
# OPTIONAL: ENHANCED WEB SEARCH
# ===========================================
# Serper API for web search
# SERPER_DEV_API_KEY=your-serper-key-here

# Olostep API for web search
# OLOSTEP_API_KEY=your-olostep-key-here

# ===========================================
# OPTIONAL: CODE EXECUTION
# ===========================================
# E2B API for code execution environment
# E2B_API_KEY=your-e2b-key-here

# ===========================================
# OPTIONAL: COMPUTER CONTROL
# ===========================================
# Enable computer control features (requires additional setup)
KHOJ_OPERATOR_ENABLED=False

# ===========================================
# OPTIONAL: DOMAIN CONFIGURATION
# ===========================================
# Your Fly.io app domain
# KHOJ_DOMAIN=your-app-name.fly.dev
# KHOJ_ALLOWED_DOMAIN=your-app-name.fly.dev

# ===========================================
# FLY.IO SPECIFIC
# ===========================================
# Port configuration (should match fly.toml)
PORT=8080

# ===========================================
# NOTES:
# ===========================================
# 1. Replace 'your-app-name' with your actual Fly.io app name
# 2. Get Supabase credentials from your project dashboard
# 3. Generate a secure Django secret key
# 4. Set strong passwords for admin account
# 5. Add your AI service API keys
# 6. All optional services can be added later
# 7. Use flyctl secrets set to add these to your Fly.io app

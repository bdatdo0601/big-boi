# Big Knowledge Graph Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# AI Model API Keys (at least one required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Admin User Configuration
KHOJ_ADMIN_EMAIL=admin@example.com
KHOJ_ADMIN_PASSWORD=change-this-strong-password
KHOJ_DJANGO_SECRET_KEY=change-this-secret-key-to-something-random

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Enhanced Web Search APIs
# JINA_API_KEY=your_jina_api_key_here                 # Free, slower web search
# SERPER_DEV_API_KEY=your_serper_dev_api_key_here     # Paid, fast web search
# FIRECRAWL_API_KEY=your_firecrawl_api_key_here       # Paid, fast web scraping
# OLOSTEP_API_KEY=your_olostep_api_key_here           # Paid, high success web scraping

# Local AI Models (OpenAI-compatible APIs)
# OPENAI_BASE_URL=http://localhost:11434/v1/          # Ollama
# KHOJ_DEFAULT_CHAT_MODEL=llama3                      # Model name

# Computer Control (VNC interface on port 5900)
# KHOJ_OPERATOR_ENABLED=False

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

# Domain Configuration (for production deployment)
# KHOJ_DOMAIN=your-domain.com
# KHOJ_ALLOWED_DOMAIN=localhost

# Security Settings
# KHOJ_NO_HTTPS=True                                  # Set to False for production with HTTPS

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Debug Mode
KHOJ_DEBUG=True                                       # Set to False for production

# Telemetry
KHOJ_TELEMETRY_DISABLE=True                          # Disable usage analytics

# ============================================================================
# RAILWAY SPECIFIC (automatically set by Railway)
# ============================================================================

# These are automatically set by Railway - don't modify
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
# RAILWAY_PRIVATE_DOMAIN=your-app.railway.internal
# PORT=42110

{
  "name": "embedding-lambda",
  "version": "1.0.0",
  "description": "Running embedding lambda on typescript",
  "main": "index.js",
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run clean && rsbuild build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:setup": "vitest run test/setup",
    "test:watch": "vitest",
    "test:watch:unit": "vitest test/unit",
    "test:watch:integration": "vitest test/integration",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run test/unit --coverage",
    "test:coverage:integration": "vitest run test/integration --coverage"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/mistral": "^1.2.8",
    "@aws-sdk/client-s3vectors": "^3.848.0",
    "@big-boi-commons/typescript": "../../commons/typescript",
    "@mastra/rag": "^1.0.4",
    "ai": "^4.3.19",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.4.9",
    "@types/lodash": "^4.17.20",
    "@vitest/coverage-v8": "^1.6.0",
    "rsbuild-plugin-aws-lambda": "^0.0.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.0"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "test/**/*.{test,spec}.ts"
    ],
    "coverage": {
      "include": [
        "src/**/*.ts"
      ],
      "exclude": [
        "src/**/*.d.ts",
        "test/**/*.ts"
      ]
    }
  }
}
